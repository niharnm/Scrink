# Supabase CLI env — copy to `supabase/.env` (gitignored) and fill in.
# Read by config.toml's env(...) references when you run `supabase config push`.

# Resend API key, used as the SMTP password (SMTP user is the literal "resend").
# Create it at https://resend.com/api-keys with "Sending access".
# The sender domain (login@rinkler.app in config.toml) must be verified in Resend.
RESEND_SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxx
