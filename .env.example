NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<from supabase start output or dashboard>
SUPABASE_SERVICE_ROLE_KEY=<from supabase start output or dashboard>
ENABLE_EXTERNAL_AI_INSIGHTS=false
ENABLE_DASHBOARD_ADMIN_TOOLS=false
NEXT_PUBLIC_ENABLE_DASHBOARD_ADMIN_TOOLS=false
# When true, only emails in public.allowed_emails may sign in/up (waitlist gate).
# Existing users were grandfathered in by migration. Approve someone with:
#   insert into public.allowed_emails(email) values ('them@example.com');
ENABLE_WAITLIST_LOCK=false

# MCP server (optional)
RINKLER_USER_ID=<your auth.users UUID>
# Required when running the MCP server over HTTP (transport != stdio).
# Must be a strong shared secret (>=16 chars); the server refuses to start without it.
MCP_API_KEY=<strong-random-secret>
# Bind address for the HTTP transport. Defaults to 127.0.0.1; set 0.0.0.0 only behind a proxy/LB.
MCP_HOST=127.0.0.1
MCP_PORT=8080
# Set to "stdio" for local stdio transport (no API key required).
MCP_TRANSPORT=httpStream
